# Copie este arquivo para .env e preencha os valores antes de subir o docker-compose.

# --- PostgreSQL ---
# A connection string da API é montada automaticamente pelo docker-compose a partir destas três.
POSTGRES_USER=pulsefx
POSTGRES_PASSWORD=pulsefx
POSTGRES_DB=pulsefx
POSTGRES_PORT=5432

# --- Auth (apps/api) ---
JWT_SECRET=8f3a9c7e2b5d1a6f9c4e8b7d2a5f1c9e
API_KEY=4d8f2a7c9e1b5d6f3a8c2e7b9f4d1a6c

# --- Seed (apps/api) ---
SEED_ADMIN_NAME=Paul Julius Reuter
SEED_ADMIN_USERNAME=paul
SEED_ADMIN_PASSWORD=thomson

# --- Fontes de dados (apps/api) ---
BCB_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata
FRED_BASE_URL=https://api.stlouisfed.org/fred
# Registrar em https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=change-me

# --- Política de sincronização (apps/api) ---
# TTL (minutos) — se o indicador já foi sincronizado há menos tempo que isso, o sync é pulado.
FX_SYNC_TTL_MINUTES=60
MACRO_SYNC_TTL_MINUTES=1440
# Dispara uma sincronização real (BCB e FRED) assim que a API sobe, respeitando o TTL acima,
# para que o banco já tenha dado logo no primeiro acesso.
SYNC_ON_STARTUP=true

# --- CORS (apps/api) ---
# Origem do frontend autorizada a chamar a API.
WEB_ORIGIN=http://localhost:3000

# --- Frontend (apps/web) ---
# URL da API que o navegador chama — precisa ser alcançável a partir da máquina do usuário
# (não um hostname interno do Docker), já que quem faz as chamadas é o navegador, não o container.
NEXT_PUBLIC_API_URL=http://localhost:3001
